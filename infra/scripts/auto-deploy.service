[Unit]
Description=Engganyo Auto-Deploy Service
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=engganyo
WorkingDirectory=/opt/engganyo-project
ExecStart=/opt/engganyo-project/infra/scripts/auto-deploy.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
