# =============================================================
# ENGGANYO — Production Environment Variables
# Copy to .env on the VPS and fill in all values.
# NEVER commit this file with real values to git.
# =============================================================

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3001
APP_URL=https://engganyo.com
FRONTEND_URL=https://engganyo.com
API_PREFIX=api

# ─── Database (with connection pooling) ──────────────────────
# connection_limit=10 keeps Prisma from opening too many connections
DATABASE_URL=postgresql://engganyo:STRONG_PASSWORD@localhost:5432/engganyo_prod?connection_limit=10&pool_timeout=30
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=engganyo_prod
DATABASE_USER=engganyo
DATABASE_PASSWORD=STRONG_PASSWORD_HERE

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (min 64 chars each, must differ) ────────────────────
JWT_ACCESS_SECRET=GENERATE_WITH__openssl_rand_-hex_64
JWT_REFRESH_SECRET=GENERATE_WITH__openssl_rand_-hex_64_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
SMTP_FROM_NAME=Engganyo
SMTP_FROM_EMAIL=noreply@engganyo.com

# ─── Security ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
COOKIE_SECRET=GENERATE_WITH__openssl_rand_-hex_32

# ─── Rate Limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Crypto ──────────────────────────────────────────────────
ENCRYPTION_KEY=GENERATE_WITH__openssl_rand_-hex_32

# ─── Admin seed ──────────────────────────────────────────────
ADMIN_EMAIL=admin@engganyo.com
ADMIN_PASSWORD=VERY_STRONG_ADMIN_PASSWORD

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_EMAIL_VERIFICATION=true
ENABLE_ANTI_ABUSE=true
ENABLE_WEBSOCKETS=true
ENABLE_RECAPTCHA=true

# ─── Observability ────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/project

# ─── reCAPTCHA v3 (for bot protection) ───────────────────────
# Get secret key from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=YOUR_RECAPTCHA_V3_SECRET_KEY

# Grafana Cloud Loki — leave blank to disable log shipping
# LOKI_URL  = https://logs-prod-XXX.grafana.net
# LOKI_USER = numeric user ID from Grafana Cloud
# LOKI_PASS = Grafana Cloud API token (Logs > Send logs scope)
LOKI_URL=
LOKI_USER=
LOKI_PASS=
