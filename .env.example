# =============================================================
# ENGGANYO — Environment Variables
# Copy to .env and fill in your values
# =============================================================

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://engganyo:engganyo_dev_pass@localhost:5432/engganyo_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=engganyo_db
DATABASE_USER=engganyo
DATABASE_PASSWORD=engganyo_dev_pass

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_strong_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_a_different_strong_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Engganyo
SMTP_FROM_EMAIL=no-reply@engganyo.com

# ─── Security ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
COOKIE_SECRET=change_this_cookie_secret

# ─── Rate Limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── API base URL (used for OAuth callbacks) ────────────────
API_BASE_URL=http://localhost:3001/api/v1

# ─── Google OAuth (YouTube verification) ─────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Scopes needed: youtube.readonly, openid, profile
# Authorized redirect URI: http://localhost:3001/api/v1/social-auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Twitch OAuth (Twitch follow verification) ───────────────
# Create at: https://dev.twitch.tv/console/apps
# Scopes needed: user:read:follows user:read:email
# Redirect URI: http://localhost:3001/api/v1/social-auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Spotify OAuth (Spotify follow verification) ─────────────
# Create at: https://developer.spotify.com/dashboard
# Scopes needed: user-follow-read user-read-private
# Redirect URI: http://localhost:3001/api/v1/social-auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Crypto (for encrypting OAuth tokens) ───────────────────
ENCRYPTION_KEY=32_byte_hex_key_here

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@engganyo.com
ADMIN_PASSWORD=change_this_admin_password

# ─── Observability ───────────────────────────────────────────
# Leave blank in dev — Sentry only activates when DSN is set
SENTRY_DSN=

# ─── reCAPTCHA v3 (for bot protection) ───────────────────────
# Get secret key from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=

# ─── Feature Flags ───────────────────────────────────────────
ENABLE_EMAIL_VERIFICATION=true
ENABLE_ANTI_ABUSE=true
ENABLE_WEBSOCKETS=true
ENABLE_RECAPTCHA=false
