  passwordHash String?             @map("password_hash") // argon2/bcrypt hash, never plaintext

  status ChallengeStatus @default(OPEN)

  // Economics — snapshotted at publish; fee collected only on settlement
  feeRateSnapshot Float @map("fee_rate_snapshot")
  feeAmount       Int   @map("fee_amount")
  reservedCredits Int   @map("reserved_credits") // reward + fee held from creator

  // The single claim — canonical link is TaskCompletion.challengeId (@unique)
  claim       TaskCompletion?
  claimedById String?         @map("claimed_by_id")
  claimedBy   User?           @relation("ChallengeClaimant", fields: [claimedById], references: [id])
  claimedAt   DateTime?       @map("claimed_at")

