// =============================================================
// ENGGANYO — Prisma Database Schema
// PostgreSQL · Prisma ORM
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum UserRole {
  USER
  CREATOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum TransactionType {
  // Earning
  EARN_TASK_COMPLETION
  EARN_REFERRAL_BONUS
  EARN_DAILY_REWARD
  EARN_ACHIEVEMENT
  EARN_LOOT_BOX
  EARN_MISSION_COMPLETE
  EARN_ADMIN_GRANT
  EARN_WHEEL_SPIN
  // Deposits (fiat / crypto)
  DEPOSIT_PAYMONGO
  DEPOSIT_PAYPAL
  DEPOSIT_CRYPTO
  // Spending
  SPEND_CAMPAIGN_CREATE
  SPEND_CAMPAIGN_BOOST
  SPEND_PREMIUM_FEATURE
  SPEND_ADMIN_DEDUCT
  SPEND_STORE_PURCHASE
  // Platform revenue
  PLATFORM_FEE_CAMPAIGN
  // Neutral
  REFUND_CAMPAIGN_CANCEL
  REFUND_COMPLETION_REJECT
  // Tipping
  SPEND_TIP
  EARN_TIP
  // 1v1 challenges
  SPEND_CHALLENGE_CREATE
  REFUND_CHALLENGE_CLOSE
  PLATFORM_FEE_CHALLENGE
  // Mutual P2P rooms (no wallet reward — equal contributions + room charge)
  SPEND_ROOM_CREATE
  SPEND_ROOM_CLAIM
  REFUND_ROOM_CLOSE
  REFUND_ROOM_RESOLUTION
  // Player item marketplace (credits-only)
  SPEND_MARKETPLACE_PURCHASE
  EARN_MARKETPLACE_SALE
}

enum DepositStatus {
  PENDING // Created, waiting for payment confirmation
  PROCESSING // Payment received, being reviewed
  COMPLETED // Credits credited to wallet
  FAILED // Payment failed
  CANCELLED // Cancelled by user or expired QR
  REFUNDED // Deposit refunded by admin
}

enum DepositMethod {
  PAYMONGO
  PAYPAL
  USDT_BEP20
  USDT_BASE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum TaskType {
  YOUTUBE_LIKE
  YOUTUBE_SUBSCRIBE
  YOUTUBE_COMMENT
  YOUTUBE_WATCH
  TIKTOK_FOLLOW
  TIKTOK_LIKE
  TIKTOK_COMMENT
  INSTAGRAM_FOLLOW
  INSTAGRAM_LIKE
  INSTAGRAM_COMMENT
  FACEBOOK_PAGE_LIKE
  FACEBOOK_POST_LIKE
  FACEBOOK_SHARE
  TWITTER_FOLLOW
  TWITTER_LIKE
  TWITTER_RETWEET
  TWITTER_REPLY
  TWITCH_FOLLOW
  SPOTIFY_FOLLOW
  SPOTIFY_STREAM
  TELEGRAM_JOIN_CHANNEL
  TELEGRAM_JOIN_GROUP
  DISCORD_JOIN_SERVER
  TRUSTPILOT_REVIEW
  GOOGLE_REVIEW
}

enum CompletionStatus {
  ASSIGNED // Task assigned to user, not yet started
  IN_PROGRESS // User has started the task
  SUBMITTED // User submitted proof
  VERIFIED // System/admin verified
  REJECTED // Proof rejected
  DISPUTED // User disputed rejection
  EXPIRED // Task expired without submission
  CANCELLED // Campaign cancelled before completion
}

enum ChallengeVisibility {
  PUBLIC
  PRIVATE
}

enum ChallengeStatus {
  OPEN // published, slot unclaimed
  CLAIMED // slot taken, awaiting proof/review
  COMPLETED // terminal — awarded or closed without award
  EXPIRED // terminal — offer window or abandoned claim elapsed
  CANCELLED // terminal — creator cancelled before claim
}

// Mutual P2P rooms — equal contributions, peer-reviewed work, no credit reward
enum RoomStatus {
  OPEN // published, awaiting joiner; creator's X reserved
  NEGOTIATING // joiner claimed + reserved; single expiresAt deadline runs
  AGREED // both approved the same offer state; 2X room charge collected
  IN_PROGRESS // at least one submission made
  SUBMITTED // both directions have submissions (derived state kept for queries)
  DISPUTED // frozen pending admin — still expires at expiresAt (V3.1a)
  COMPLETED // terminal — both directions verified, +1 P2P point each
  CLOSED // terminal — closed pre-agreement, each own X refunded
  EXPIRED // terminal — deadline elapsed in any active state, unwind applied
}

enum RoomOfferStatus {
  PROPOSED
  APPROVED
  LOCKED
  REJECTED
}

enum RoomSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  DISPUTED
}

enum RoomRole {
  CREATOR
  CLAIMER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SocialPlatform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
  TWITTER
  TWITCH
  SPOTIFY
  TELEGRAM
  DISCORD
  TRUSTPILOT
  GOOGLE
}

enum NotificationType {
  TASK_AVAILABLE
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_REJECTED
  CAMPAIGN_ACTIVE
  CAMPAIGN_COMPLETED
  CAMPAIGN_PAUSED
  CAMPAIGN_REJECTED
  CREDIT_EARNED
  CREDIT_SPENT
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  STREAK_REMINDER
  STREAK_BROKEN
  REFERRAL_JOINED
  REFERRAL_QUALIFIED
  DAILY_MISSION_AVAILABLE
  DAILY_REWARD_AVAILABLE
  REPORT_RESOLVED
  SYSTEM_ANNOUNCEMENT
  SECURITY_ALERT
  ACCOUNT_WARNING
  FORUM_MENTION
  CHANNEL_MENTION
  WELCOME
  VIP_POINTS_EARNED
  TIP_RECEIVED
  ROOM_NUDGE
  ROOM_UPDATE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
}

enum ReportReason {
  FAKE_COMPLETION
  SPAM_CAMPAIGN
  INAPPROPRIATE_CONTENT
  MULTI_ACCOUNTING
  BOT_ACTIVITY
  HARASSMENT
  MISLEADING_TASK
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AchievementCategory {
  ENGAGEMENT // task completion related
  CREATOR // campaign related
  COMMUNITY // referral / social related
  DEDICATION // streak / login related
  FINANCIAL // credits related
  MILESTONE // level/rank related
}

enum MissionType {
  COMPLETE_N_TASKS
  CREATE_CAMPAIGN
  EARN_N_CREDITS
  LOGIN_STREAK
  REFER_USER
  CONNECT_SOCIAL
  VISIT_DISCOVER
}

enum StoreCategory {
  BOOST
  COSMETIC
  CONVENIENCE
  CREDIT_PACK
  GUILD_PERK
}

enum TrustLevel {
  NEW // 0-20  — new account, limited access
  LOW // 21-40 — some concerns
  MEDIUM // 41-60 — average user
  HIGH // 61-80 — trusted user
  VERIFIED // 81-100 — fully trusted creator
}

enum ForumTopicStatus {
  OPEN
  LOCKED
  PINNED
  HIDDEN
}

enum ForumReactionType {
  LIKE
  DISLIKE
  LOVE
  LAUGH
  ANGRY
}

// =============================================================
// CORE USER MODELS
// =============================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  // Basic profile
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String? @db.Text

  // Gamification stats (denormalized for performance)
  xp              Int   @default(0)
  level           Int   @default(1)
  reputationScore Float @default(0) @map("reputation_score")

  // VIP Points & Tier (denormalized for quick reads)
  vp        Int      @default(0)
  vipTierId String?  @map("vip_tier_id")
  vipTier   VipTier? @relation(fields: [vipTierId], references: [id])

  // Wallet balance (denormalized from wallet for quick reads)
  creditBalance Int @default(0) @map("credit_balance")

  // Streaks & activity
  currentStreak       Int       @default(0) @map("current_streak")
  longestStreak       Int       @default(0) @map("longest_streak")
  streakFreezeCharges Int       @default(0) @map("streak_freeze_charges")
  lastActiveAt        DateTime? @map("last_active_at")
  lastDailyRewardAt   DateTime? @map("last_daily_reward_at")
  lastClaimIp         String?   @map("last_claim_ip") @db.VarChar(45)
  registrationIp      String?   @map("registration_ip") @db.VarChar(45)

  // Referral
  referralCode String  @unique @map("referral_code")
  referredById String? @map("referred_by_id")

  // Two-Factor Authentication
  twoFactorTotpSecret   String? @map("two_factor_totp_secret") // AES-encrypted; null = TOTP not configured
  twoFactorEmailEnabled Boolean @default(false) @map("two_factor_email_enabled")

  // Email preferences
  weeklyDigestEnabled Boolean @default(true) @map("weekly_digest_enabled")

  // Admin Access PIN (hashed with argon2; optional extra gate for /admin routes)
  adminPinHash String? @map("admin_pin_hash")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete

  // ─── Relations ─────────────────────────────────────────────
  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferrals")

  profile                UserProfile?
  wallet                 Wallet?
  sessions               UserSession[]
  emailVerifications     EmailVerification[]
  passwordResets         PasswordReset[]
  socialAccounts         SocialAccount[]
  campaigns              Campaign[]
  challenges             Challenge[]             @relation("ChallengeCreator")
  challengeClaims        Challenge[]             @relation("ChallengeClaimant")
  completions            TaskCompletion[]
  notifications          Notification[]
  reportsSubmitted       Report[]                @relation("ReportSubmitter")
  reportsReceived        Report[]                @relation("ReportTarget")
  userAchievements       UserAchievement[]
  missionProgress        UserMissionProgress[]
  chats                  ChatConversation[]      @relation("UserChats")
  assignedChats          ChatConversation[]      @relation("AgentChats")
  trustScore             TrustScore?
  abuseFlags             AbuseFlag[]
  ipRecords              IpRecord[]
  auditLogs              AuditLog[]
  referralsGiven         Referral[]              @relation("ReferralReferrer")
  referralReceived       Referral?               @relation("ReferralReferee")
  forumTopics            ForumTopic[]            @relation("ForumTopics")
  forumReplies           ForumReply[]            @relation("ForumReplies")
  forumReactions         ForumReaction[]         @relation("ForumReactions")
  twoFactorCodes         TwoFactorCode[]
  twoFactorBackupCodes   TwoFactorBackupCode[]
  deposits               Deposit[]
  channelMemberships     ChannelMember[]
  channelMessages        ChannelMessage[]
  channelMessageMentions ChannelMessageMention[]
  createdChannels        Channel[]               @relation("ChannelCreator")
  storePurchases         StorePurchase[]
  inventory              UserInventory[]
  activeEffects          UserActiveEffect[]
  wheelSpins             WheelSpin[]
  wheelSpinAttempts      WheelSpinAttempt[]
  wheelDailyAllowances   WheelDailyAllowance[]
  dailyRewardLogs        DailyRewardLog[]
  roomsCreated           ChallengeRoom[]         @relation("RoomCreator")
  roomsJoined            ChallengeRoom[]         @relation("RoomClaimer")
  roomOffers             RoomOffer[]
  roomSubmissions        RoomSubmission[]
  p2pPointEvents         P2pPointEvent[]
  roomDisputesOpened     RoomDispute[]           @relation("DisputeOpener")
  roomParticipations     RoomParticipation[]
  roomNudgesSent         RoomNudge[]             @relation("NudgeSender")
  roomRatingsGiven       RoomRating[]            @relation("RatingGiver")
  roomRatingsReceived    RoomRating[]            @relation("RatingReceiver")
  friendshipsRequested   Friendship[]            @relation("FriendshipRequester")
  friendshipsReceived    Friendship[]            @relation("FriendshipAddressee")

  @@index([email])
  @@index([username])
  @@index([referralCode])
  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([vipTierId])
  @@index([vp])
  @@map("users")
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Extended info
  websiteUrl String?  @map("website_url")
  location   String?
  timezone   String?
  niche      String[] // creator niche tags (e.g. "gaming", "music", "tech")
  languages  String[] // spoken languages

  // Social proof metrics (updated periodically)
  totalFollowers Int   @default(0) @map("total_followers")
  totalTasksDone Int   @default(0) @map("total_tasks_done")
  totalCampaigns Int   @default(0) @map("total_campaigns")
  completionRate Float @default(0) @map("completion_rate")

  isPublic      Boolean @default(true) @map("is_public")
  allowMentions Boolean @default(true) @map("allow_mentions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model UserSession {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String   @unique @map("refresh_token")
  deviceInfo   Json?    @map("device_info")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  isRevoked    Boolean  @default(false) @map("is_revoked")
  expiresAt    DateTime @map("expires_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model EmailVerification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@index([email])
  @@map("email_verifications")
}

model PasswordReset {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model TwoFactorCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // argon2-hashed 6-digit code
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("two_factor_codes")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // argon2-hashed backup code
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// =============================================================
// SOCIAL ACCOUNTS
// =============================================================

model OAuthConfig {
  platform     SocialPlatform @id
  clientId     String?        @map("client_id")
  clientSecret String?        @map("client_secret")
  enabled      Boolean        @default(false)
  updatedAt    DateTime       @updatedAt @map("updated_at")
  updatedById  String?        @map("updated_by_id")

  @@map("oauth_configs")
}

model SocialAccount {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform         SocialPlatform
  platformUserId   String         @map("platform_user_id")
  platformUsername String?        @map("platform_username")
  profileUrl       String?        @map("profile_url")
  avatarUrl        String?        @map("avatar_url")

  // Encrypted OAuth tokens
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")

  followerCount Int?      @map("follower_count")
  isVerified    Boolean   @default(false) @map("is_verified")
  lastSyncedAt  DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform, platformUserId])
  @@map("social_accounts")
}

// =============================================================
// CREDIT ECONOMY
// =============================================================

model Wallet {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance        Int @default(0) // current balance (integer credits)
  lifetimeEarned Int @default(0) @map("lifetime_earned")
  lifetimeSpent  Int @default(0) @map("lifetime_spent")

  // Optimistic locking to prevent race conditions
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id       String @id @default(cuid())
  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id])

  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  // All amounts in integer credits; positive = credit, negative = debit
  amount        Int
  balanceBefore Int @map("balance_before")
  balanceAfter  Int @map("balance_after")

  description String? @db.Text

  // Polymorphic reference to source entity
  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type") // 'campaign' | 'completion' | 'referral' | 'achievement'

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Optional backlink to channel message for tips
  tipMessage     ChannelMessage?
  storePurchases StorePurchase[]

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([referenceId, referenceType])
  @@index([createdAt])
  @@map("transactions")
}

// =============================================================
// CAMPAIGNS & TASKS
// =============================================================

model Campaign {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?  @db.Text
  taskType    TaskType @map("task_type")
  targetUrl   String   @map("target_url")

  // Slots & economics
  totalSlots     Int @map("total_slots") // total completions needed
  completedSlots Int @default(0) @map("completed_slots")
  pendingSlots   Int @default(0) @map("pending_slots") // assigned but not verified
  creditPerTask  Int @map("credit_per_task") // credits paid to completer per task
  totalCost      Int @map("total_cost") // totalSlots * creditPerTask (pre-paid pool)

  // Platform fee (computed at creation, locked)
  feeAmount       Int    @default(0) @map("fee_amount")
  feeRateAtCreate Float  @default(0.10) @map("fee_rate_at_create")
  feeTier         String @default("STANDARD") @map("fee_tier") // SIMPLE | STANDARD | COMPLEX | CUSTOM

  status          CampaignStatus @default(DRAFT)
  rejectionReason String?        @map("rejection_reason")

  // Targeting filters
  targetCountries String[] @map("target_countries")
  targetLanguages String[] @map("target_languages")
  minTrustScore   Float    @default(0) @map("min_trust_score")

  // Verification settings
  verificationMethod String? @map("verification_method") // 'screenshot' | 'oauth' | 'delayed'
  cooldownHours      Int     @default(24) @map("cooldown_hours") // prevent same user recycle
  requiresProof      Boolean @default(true) @map("requires_proof")
  proofInstructions  String? @map("proof_instructions") @db.Text
  autoVerify         Boolean @default(true) @map("auto_verify") // true = instant payout; false = admin must review proof

  // Platform task flag - if true, admin creator can assign/complete for testing (no credit reward)
  isPlatformTask Boolean @default(false) @map("is_platform_task")

  // Scheduling
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  completions     TaskCompletion[]
  reports         Report[]
  forumReplies    ForumReply[]     @relation("ForumCampaignReplies")
  forumTopics     ForumTopic[]     @relation("ForumCampaignTopics")
  platformRevenue PlatformRevenue?

  @@index([userId])
  @@index([status])
  @@index([taskType])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("campaigns")
}

model PlatformRevenue {
  id             String         @id @default(cuid())
  date           DateTime       @db.Date
  source         String // "CAMPAIGN_FEE" | "CHALLENGE_FEE" | "CREDIT_PURCHASE" | "WITHDRAWAL_FEE"
  amount         Int
  campaignId     String?        @unique @map("campaign_id")
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  challengeId    String?        @unique @map("challenge_id")
  challenge      Challenge?     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  roomId         String?        @unique @map("room_id")
  room           ChallengeRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reversedAt     DateTime?      @map("reversed_at") // ROOM_CHARGE unwind on expiry/dispute
  reversalReason String?        @map("reversal_reason")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([date])
  @@index([source])
  @@map("platform_revenue")
}

model TaskCompletion {
  id          String     @id @default(cuid())
  campaignId  String?    @map("campaign_id")
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  challengeId String?    @unique @map("challenge_id")
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id])

  status        CompletionStatus @default(ASSIGNED)
  creditsEarned Int              @default(0) @map("credits_earned")

  // Proof submission
  proofUrl        String? @map("proof_url")
  proofScreenshot String? @map("proof_screenshot")
  proofData       Json?   @map("proof_data") // flexible proof metadata
  proofHash       String? @map("proof_hash") // SHA256 of uploaded file for duplicate detection

  // Verification tracking
  verifiedAt      DateTime? @map("verified_at")
  verifiedBy      String?   @map("verified_by") // userId or 'system'
  rejectionReason String?   @map("rejection_reason")

  // Anti-abuse fingerprinting
  ipAddress         String? @map("ip_address")
  deviceFingerprint String? @map("device_fingerprint")
  completionSeconds Int?    @map("completion_seconds") // time from assign to submit

  // Timing
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  startedAt      DateTime? @map("started_at")
  submittedAt    DateTime? @map("submitted_at")
  expiresAt      DateTime? @map("expires_at")
  reviewDeadline DateTime? @map("review_deadline") // creator has until this time; after → escalated to admin

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, userId]) // One completion per user per campaign
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([proofHash])
  @@map("task_completions")
}

// =============================================================
// 1v1 P2P CHALLENGES
// =============================================================

model Challenge {
  id        String @id @default(cuid())
  creatorId String @map("creator_id")
  creator   User   @relation("ChallengeCreator", fields: [creatorId], references: [id])

  title      String
  actionText String   @map("action_text") @db.Text
  taskType   TaskType @map("task_type")
