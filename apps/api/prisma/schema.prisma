// Durable per-completion reward outcome. Created atomically inside the
// VERIFIED transition transaction; a processor then settles each effect
// (XP, VP, mission, achievements, referral) with persistent per-effect
// flags so a crash mid-processing resumes instead of losing rewards.
// Exactly-once per effect is enforced by each effect's own dedupe
// (xp/vp events, mission progress events, achievement unique row,
// referral milestone map) — flags only track progress.
model TaskCompletionOutcome {
  id                  String    @id @default(cuid())
  completionId        String    @unique @map("completion_id")
  userId              String    @map("user_id")
  status              String    @default("PENDING") // PENDING | DONE | FAILED | CANCELLED
  xpSettled           Boolean   @default(false) @map("xp_settled")
  vpSettled           Boolean   @default(false) @map("vp_settled")
  missionSettled      Boolean   @default(false) @map("mission_settled")
  achievementsSettled Boolean   @default(false) @map("achievements_settled")
  referralSettled     Boolean   @default(false) @map("referral_settled")
  attempts            Int       @default(0)
  lastError           String?   @map("last_error")
  // Processing lease: a worker claims the outcome with a unique token
  // before touching effects. All outcome writes are conditional on the
  // token, so a stale worker can never overwrite DONE/CANCELLED or
  // acknowledge another worker's claim. A crashed worker's claim goes
  // stale after the lease TTL and becomes re-claimable.
  claimedAt           DateTime? @map("claimed_at")
  claimToken          String?   @map("claim_token")
  // Reward terms frozen at the qualifying VERIFIED event: eligible
  // mission IDs + requirement/credit/xp terms and the XP boost
  // multiplier observed at that instant. NULL = legacy/defensive row —
  // processing falls back to live configuration (documented policy for
  // outcomes recorded before this column existed).
  rewardSnapshot      Json?     @map("reward_snapshot")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  processedAt         DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@map("task_completion_outcomes")
}

// Freeze marker for one UTC period's mission catalog. Inserted once by
// the first touch of the period (missions read, VERIFIED outcome, or
// admin mutation); only the winner writes mission_period_terms, so the
// catalog is all-or-nothing — missions created mid-period can never
// acquire a term row for the current period.
model MissionPeriodCatalog {
  periodDate DateTime @id @map("period_date") @db.Date
  frozenAt   DateTime @default(now()) @map("frozen_at")

  @@map("mission_period_catalogs")
}

// Immutable mission catalog for one UTC period. The first touch of the
// period (daily-missions read, qualifying event, or admin mutation)
// freezes every active mission's display + eligibility + settlement
// terms (ON CONFLICT DO NOTHING); later config edits are scheduled into
// the next period by the admin mutations, so mid-period changes cannot
// alter today's eligibility and every worker pays identical terms.
// Rows survive daily_missions deletion — they ARE the referenced
// historical definition for in-flight progress and payouts.
model MissionPeriodTerm {
  id           String   @id @default(cuid())
  missionId    String   @map("mission_id")
  periodDate   DateTime @map("period_date") @db.Date
  name         String
  description  String   @default("")
  type         String
  icon         String?
  requirement  Int
  creditReward Int      @map("credit_reward")
  xpReward     Int      @map("xp_reward")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([missionId, periodDate])
  @@index([periodDate, type])
  @@map("mission_period_terms")
}

// Per-mission qualifying-event dedupe. A repeated delivery of the same
// source event (e.g. outcome recovery re-running mission progress for a
// completionId) must not count the task twice; distinct events each
// count once per mission.
model MissionProgressEvent {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  missionId  String   @map("mission_id")
  sourceType String   @map("source_type") // MissionType value
  sourceId   String   @map("source_id")   // e.g. task completion id
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([missionId, sourceType, sourceId])
  @@index([userId, date])
  @@map("mission_progress_events")
}

model XpEvent {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  amount      Int // applied delta actually added to user.xp (post-boost)
  baseAmount  Int?    @map("base_amount") // pre-boost amount
  boostMultiplier Float? @map("boost_multiplier")
  source      String // 'task_completion' | 'campaign_create' | 'achievement' | 'daily_login'
  referenceId String? @map("reference_id")
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([userId, source, referenceId])
  @@map("xp_events")
}

// Durable post-commit delivery queue for reward side-effects
// (notifications + socket events). Rows are written INSIDE the reward
// transaction so they commit or roll back with it; delivery happens only
// after commit via flushRewardOutbox (inline) and a periodic sweeper, so
// rolled-back or retried attempts can never emit premature/duplicate
// notifications.
model RewardOutboxEvent {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  kind             String    // 'notification' | 'socket'
  notificationType String?   @map("notification_type")
  title            String?
  body             String?
  data             Json?
  socketEvent      String?   @map("socket_event")
  socketPayload    Json?     @map("socket_payload")
  status           String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts         Int       @default(0)
  lastError        String?   @map("last_error")
  processingAt     DateTime? @map("processing_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  deliveredAt      DateTime? @map("delivered_at")

  @@index([status, createdAt])
  @@map("reward_outbox_events")
}

// Durable reward entitlement — written inside the settlement
// transaction so a reward obligation survives crashes. PENDING rows are
// processed idempotently; UNRESOLVED rows retain the entitlement until
// the missing input (e.g. a USD valuation) is backfilled and the row is
// re-settled. Unique (source, referenceId) makes creation replay-safe.
model RewardEntitlement {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  kind             String    // 'vp'
  amount           Int?
  source           String    // 'deposit_completed' | ...
  referenceId      String    @map("reference_id")
  referenceType    String?   @map("reference_type")
  description      String?
  status           String    @default("PENDING") // PENDING | SETTLED | UNRESOLVED | CANCELLED
  unresolvedReason String?   @map("unresolved_reason")
  metadata         Json?
  // Sweep backoff: unresolvable entitlements are retried at most once per
  // window so they cannot starve newer eligible work at the head of the
  // queue. Null = eligible now.
  nextAttemptAt    DateTime? @map("next_attempt_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  settledAt        DateTime? @map("settled_at")

  @@unique([source, referenceId])
  @@index([status])
  @@index([status, nextAttemptAt])
  @@map("reward_entitlements")
}

model VpEvent {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  amount      Int
  source      String // 'task_completion' | 'deposit_completed' | 'daily_login' | 'level_up' | 'campaign_create'
  referenceId String? @map("reference_id")
  description String?

  createdAt DateTime @default(now()) @map("created_at")

