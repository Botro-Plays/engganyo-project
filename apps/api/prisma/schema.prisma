model ChatConversation {
  id        String  @id @default(cuid())
  userId    String? @map("user_id") // null for anonymous users
  ipAddress String? @map("ip_address") // for anonymous users

  status     ChatStatus @default(AI_HANDLING)
  assignedTo String?    @map("assigned_to") // admin userId when transferred to human

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?         @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)
  agent    User?         @relation("AgentChats", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  isHuman        Boolean  @default(false) @map("is_human") // true if sent by human agent

  createdAt DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ChatStatus {
  AI_HANDLING
  PENDING_HUMAN
  HUMAN_HANDLING
  CLOSED
}

enum ChatRole {
  USER
  ASSISTANT
}

// =============================================================
// USER CHAT SYSTEM (Real-time channels)
// =============================================================

enum ChannelType {
  PUBLIC // Open to all authenticated users
  VIP // VIP-only channels
  PRIVATE // Invite-only / DM
  ADMIN // Admin/mod only
}

enum ChannelMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

model Channel {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique // URL-friendly identifier
  type        ChannelType @default(PUBLIC)
  description String?     @db.Text
  createdById String?     @map("created_by_id")
  createdBy   User?       @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  members       ChannelMember[]
  messages      ChannelMessage[]
  ChallengeRoom ChallengeRoom?

  @@index([type, isActive])
  @@index([slug])
  @@map("channels")
}

model ChannelMember {
  id         String            @id @default(cuid())
  channelId  String            @map("channel_id")
  channel    Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ChannelMemberRole @default(MEMBER)
  joinedAt   DateTime          @default(now()) @map("joined_at")
  lastReadAt DateTime?         @map("last_read_at")

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model ChannelMessage {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // For tip transactions linked to messages
  tipTransactionId String?      @unique @map("tip_transaction_id")
  tipTransaction   Transaction? @relation(fields: [tipTransactionId], references: [id])

  reports  Report[]
  mentions ChannelMessageMention[]

  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@map("channel_messages")
}

model ChannelMessageMention {
  id        String         @id @default(cuid())
  messageId String         @map("message_id")
  message   ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("channel_message_mentions")
}

// =============================================================
// FORUM SYSTEM
// =============================================================

model ForumTopic {
  id         String           @id @default(cuid())
  title      String
  content    String           @db.Text
  status     ForumTopicStatus @default(OPEN)
  isPinned   Boolean          @default(false) @map("is_pinned")
  viewCount  Int              @default(0) @map("view_count")
  replyCount Int              @default(0) @map("reply_count")
  lockedAt   DateTime?        @map("locked_at")
  lockedBy   String?          @map("locked_by")

  authorId String @map("author_id")
  author   User   @relation("ForumTopics", fields: [authorId], references: [id], onDelete: Cascade)

  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation("ForumCampaignTopics", fields: [campaignId], references: [id], onDelete: SetNull)

  replies   ForumReply[]
  reactions ForumReaction[]
  reports   Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([status])
  @@index([isPinned])
  @@index([campaignId])
  @@index([createdAt])
  @@map("forum_topics")
}

model ForumReply {
  id       String    @id @default(cuid())
  content  String    @db.Text
  isEdited Boolean   @default(false) @map("is_edited")
  editedAt DateTime? @map("edited_at")

  topicId String     @map("topic_id")
  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("ForumReplies", fields: [authorId], references: [id], onDelete: Cascade)

  campaignId String?   @map("campaign_id")
  campaign   Campaign? @relation("ForumCampaignReplies", fields: [campaignId], references: [id], onDelete: SetNull)

  parentReplyId String?      @map("parent_reply_id")
  parentReply   ForumReply?  @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies  ForumReply[] @relation("ReplyReplies")

  reactions ForumReaction[]
  reports   Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@index([authorId])
  @@index([campaignId])
  @@index([parentReplyId])
  @@index([createdAt])
  @@map("forum_replies")
}

model ForumReaction {
  id   String            @id @default(cuid())
  type ForumReactionType

  topicId String?     @map("topic_id")
  topic   ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  replyId String?     @map("reply_id")
  reply   ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("ForumReactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([topicId, userId])
  @@unique([replyId, userId])
  @@index([userId])
  @@map("forum_reactions")
}

// =============================================================
// IN-APP STORE
// =============================================================

model StoreItem {
  id                   String        @id @default(cuid())
  name                 String
  description          String?
  category             StoreCategory
  creditCost           Int           @map("credit_cost")
  isLimited            Boolean       @default(false) @map("is_limited")
  limitedQty           Int?          @map("limited_qty") // NULL = unlimited
  startsAt             DateTime?     @map("starts_at")
  endsAt               DateTime?     @map("ends_at")
  isActive             Boolean       @default(true) @map("is_active")
  isConsumable         Boolean       @default(true) @map("is_consumable")
  maxOwnedPerUser      Int?          @map("max_owned_per_user") // NULL = unlimited
  requiredVipTierLevel Int?          @map("required_vip_tier_level") // NULL = no requirement
  metadata             Json // item-specific data (boost duration, cosmetic URL, etc.)

  purchases          StorePurchase[]
  inventory          UserInventory[]
  marketplaceListings MarketplaceListing[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, isActive])
  @@index([isActive])
  @@map("store_items")
}

// Where a stack of inventory units came from. Bound classes (LEGACY,
// ADMIN_GRANT, REWARD) can never be listed on the marketplace; only
// credit-acquired classes (PURCHASE, MARKETPLACE) are tradable. Stacks are
// segregated per provenance so bound and tradable units can never merge.
enum InventoryProvenance {
  LEGACY
  PURCHASE
  ADMIN_GRANT
  REWARD
  MARKETPLACE
  ACTIVITY_REWARD
}

model UserInventory {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String              @map("item_id")
  item        StoreItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int                 @default(1)
  provenance  InventoryProvenance @default(LEGACY)
  consumedAt  DateTime?           @map("consumed_at") // for consumables like boosts
  equipped    Boolean             @default(false) @map("equipped") // for cosmetics: whether this item is currently active
  acquiredAt  DateTime            @default(now()) @map("acquired_at")

  @@unique([userId, itemId, provenance])
  @@index([userId])
  @@index([itemId])
  @@map("user_inventory")
}

// Append-only audit trail for every user_inventory quantity change.
// Written inside the same transaction as the mutation so a committed
// inventory change always has its movement row (and vice versa).
model InventoryMovement {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  itemId        String              @map("item_id")
  inventoryId   String?             @map("inventory_id")
  delta         Int
  quantityAfter Int?                @map("quantity_after")
  reason        String // purchase | use | grant | loot_box | wheel | daily_reward | marketplace_list | marketplace_return | marketplace_receive | admin_adjust
  refType       String?             @map("ref_type")
  refId         String?             @map("ref_id")
  provenance    InventoryProvenance?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([itemId])
  @@index([reason])
  @@map("inventory_movements")
}

model StorePurchase {
  id                   String      @id @default(cuid())
  userId               String      @map("user_id")
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId               String      @map("item_id")
  item                 StoreItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transactionId        String      @unique @map("transaction_id")
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  quantity             Int         @default(1)
  creditCostAtPurchase Int         @map("credit_cost_at_purchase")
  createdAt            DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([itemId])
  @@index([transactionId])
  @@map("store_purchases")
}

model UserActiveEffect {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'xp_boost', 'task_limit_boost'
  metadata  Json // { multiplier: 2, expiresAt: "..." } or { bonusSlots: 5, expiresAt: "..." }
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, type])
  @@map("user_active_effects")
}

// =============================================================
// PLAYER ITEM MARKETPLACE — credits-only, consumables v1
// =============================================================

// A listing escrows `quantity` units out of the seller's inventory at
// creation (the inventory row is decremented in the same transaction).
// remainingQuantity decrements per completed order; at 0 the listing is
// SOLD_OUT. Listings are never deleted — terminal states keep history.
enum MarketplaceListingStatus {
  ACTIVE
  PAUSED // catalog drift detected — escrow held until seller cancels/expires
  SOLD_OUT
  CANCELLED
  EXPIRED
  REMOVED // admin takedown
}

model MarketplaceListing {
  id               String                    @id @default(cuid())
  sellerId         String                    @map("seller_id")
  itemId           String                    @map("item_id")
  item             StoreItem                 @relation(fields: [itemId], references: [id])
  inventoryId      String                    @map("inventory_id") // provenance stack the escrow came from
  provenance       InventoryProvenance // stack class the escrowed units belong to (for correct returns)
  itemSnapshot     Json                      @map("item_snapshot") // immutable name/category/description at list time
  originalQuantity Int                       @map("original_quantity")
  remainingQuantity Int                      @map("remaining_quantity")
  unitPrice        Int                       @map("unit_price") // credits per unit
  status           MarketplaceListingStatus  @default(ACTIVE)
  expiresAt        DateTime                  @map("expires_at")
  removedReason    String?                   @map("removed_reason")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  closedAt         DateTime?                 @map("closed_at")

  orders MarketplaceOrder[]

  @@index([status, expiresAt])
  @@index([sellerId, status])
  @@index([itemId])
  @@map("marketplace_listings")
}

// One row per completed purchase. purchaseKey is the buyer-supplied
// idempotency key — unique per buyer so retries/double-submits replay the
// committed order instead of double-charging.
model MarketplaceOrder {
  id                   String   @id @default(cuid())
  listingId            String   @map("listing_id")
  listing              MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId              String   @map("buyer_id")
  sellerId             String   @map("seller_id")
  itemId               String   @map("item_id")
  quantity             Int
  unitPrice            Int      @map("unit_price")
  totalPrice           Int      @map("total_price")
  feeAmount            Int      @default(0) @map("fee_amount") // 0% during internal test; permanent fee disabled
  status               String   @default("COMPLETED") // COMPLETED | REFUNDED
  purchaseKey          String   @map("purchase_key")
  buyerTransactionId   String?  @map("buyer_transaction_id")
  sellerTransactionId  String?  @map("seller_transaction_id")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([buyerId, purchaseKey])
  @@index([listingId])
  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
  @@map("marketplace_orders")
}

// =============================================================
// GAMIFICATION — Sprint 3 (Wheel + Daily Reward Log)
// =============================================================

model WheelSpin {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result    String // prize identifier
  isFree    Boolean  @map("is_free")
  cost      Int      @default(0) // credits spent (0 if free)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("wheel_spins")
}

// Idempotent spin attempts: unique(userId, key) enforced at the database
// level inside the same transaction as the spin settlement. A committed
// attempt stores the recoverable result so a lost response can be replayed
// without a second charge.
enum WheelSpinAttemptStatus {
  PENDING
  COMMITTED
}

model WheelSpinAttempt {
  id        String                 @id @default(cuid())
  userId    String                 @map("user_id")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String                 @map("key")
  status    WheelSpinAttemptStatus @default(PENDING)
  result    Json?
  createdAt DateTime               @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("wheel_spin_attempts")
}

// Authoritative per-user, per-UTC-day spin allowance. Rows are created and
// mutated only inside the spin settlement transaction via conditional
// updateMany, so the free spin and the 10-paid-spin daily cap cannot be
// exceeded by concurrent requests or left consumed by a rollback.
model WheelDailyAllowance {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // UTC calendar day, YYYY-MM-DD
  freeUsed  Boolean  @default(false) @map("free_used")
  paidUsed  Int      @default(0) @map("paid_used")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, day])
  @@index([userId])
  @@map("wheel_daily_allowances")
}

model DailyRewardLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakDay    Int      @map("streak_day")
  creditReward Int      @map("credit_reward")
  xpReward     Int      @map("xp_reward")
  bonusLootBox Boolean  @default(false) @map("bonus_loot_box")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("daily_reward_logs")
}

// Single-use, expiring signature challenge proving ownership of a declared
// EVM wallet. Bound to account + chain (+ deposit when supplied). Consumed
// atomically on signature verification.
model WalletChallenge {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  wallet     String // declared EVM address (lowercase)
  chain      String // "BSC" | "BASE"
  depositId  String?   @map("deposit_id")
  nonce      String    @unique
  message    String // full personal_sign payload shown to the wallet
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("wallet_challenges")
}

// =============================================================
// VISITOR ANALYTICS (first-party beacon)
// =============================================================

// One row per tracked page-view beacon. Raw events are retained for
// VISITOR_RAW_RETENTION_DAYS (default 90); aggregates live in
// AnalyticsDailyVisit for VISITOR_AGGREGATE_RETENTION_MONTHS (24).
model VisitorEvent {
  id             String        @id @default(cuid())
  eventId        String        @unique @map("event_id") // client nonce — dedupes retries
  visitId        String        @map("visit_id") // engganyo_vid cookie value
  visitDbId      String?       @map("visit_db_id")
  visit          VisitorVisit? @relation(fields: [visitDbId], references: [id])
  path           String // normalized route, no query/fragment
  referrerDomain String?       @map("referrer_domain") // external host only, or null = direct
  country        String? // CF-IPCountry via trusted proxy header
  deviceClass    String        @map("device_class") // mobile | tablet | desktop | other
  isBot          Boolean       @default(false) @map("is_bot")
  ipAddress      String?       @map("ip_address") // SUPER_ADMIN drill-down only
  userAgent      String?       @map("user_agent") // truncated
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([visitId, createdAt])
  @@index([path, createdAt])
  @@index([country, createdAt])
  @@index([referrerDomain, createdAt])
  @@index([deviceClass, createdAt])
  @@index([isBot, createdAt])
  @@map("visitor_events")
}

// Session-grain row: a "visit" is a burst of beacon activity per visitId
// with no gap longer than the 30-minute session window. Derived at ingest.
model VisitorVisit {
  id             String         @id @default(cuid())
  visitId        String         @map("visit_id")
  startedAt      DateTime       @map("started_at")
  lastSeenAt     DateTime       @map("last_seen_at")
  pageViews      Int            @default(1) @map("page_views")
  entryPath      String         @map("entry_path")
  exitPath       String?        @map("exit_path")
  referrerDomain String?        @map("referrer_domain")
  country        String?
  deviceClass    String         @map("device_class")
  isBot          Boolean        @default(false) @map("is_bot")
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  events         VisitorEvent[]
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([visitId, lastSeenAt])
  @@index([startedAt])
  @@index([isBot, startedAt])
  @@index([country, startedAt])
  @@index([referrerDomain, startedAt])
  @@index([deviceClass, startedAt])
  @@map("visitor_visits")
}

// Nightly rollup powering long-range trend (> raw retention). One row per
// (date, dimension, value); 'all' rows feed the headline trend.
model AnalyticsDailyVisit {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  dimension      String // 'all' | 'route' | 'country' | 'referrer' | 'device'
  value          String // dimension value; '*' for the 'all' row
  visits         Int      @default(0)
  pageViews      Int      @default(0) @map("page_views")
  bounces        Int      @default(0) // visits with exactly one page view
  uniqueVisitors Int      @default(0) @map("unique_visitors") // day-level distinct visitIds — sums over ranges are an estimate

  @@unique([date, dimension, value])
  @@index([date])
  @@map("analytics_daily_visits")
}

// =============================================================
// =============================================================
// MUTUAL P2P ROOMS — equal contributions, peer review, no credit reward
// =============================================================

model ChallengeRoom {
  id                  String              @id @default(cuid())
  creatorId           String              @map("creator_id")
  creator             User                @relation("RoomCreator", fields: [creatorId], references: [id])
  claimerId           String?             @map("claimer_id")
  claimer             User?               @relation("RoomClaimer", fields: [claimerId], references: [id])
  contributionCredits Int                 @map("contribution_credits")
  roomCharge          Int                 @map("room_charge")
  title               String
  visibility          ChallengeVisibility @default(PUBLIC)
  passwordHash        String?             @map("password_hash")
  status              RoomStatus          @default(OPEN)
  channelId           String?             @unique @map("channel_id")
  channel             Channel?            @relation(fields: [channelId], references: [id], onDelete: SetNull)

  creatorApproval Json? @map("creator_approval")
  claimerApproval Json? @map("claimer_approval")

  claimExpiresAt DateTime  @map("claim_expires_at")
  startedAt      DateTime? @map("started_at")
  expiresAt      DateTime? @map("expires_at")

  creatorTxId       String?   @map("creator_tx_id")
  claimerTxId       String?   @map("claimer_tx_id")
  chargeCollectedAt DateTime? @map("charge_collected_at")
  closedAt          DateTime? @map("closed_at")
  closeReason       String?   @map("close_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offers          RoomOffer[]
  submissions     RoomSubmission[]
  pointEvents     P2pPointEvent[]
  disputes        RoomDispute[]
  participations  RoomParticipation[]
  nudges          RoomNudge[]
  ratings         RoomRating[]
  reports         Report[]
  platformRevenue PlatformRevenue[]

  @@index([status, visibility, createdAt])
  @@index([creatorId])
  @@index([claimerId])
  @@index([expiresAt])
  @@map("challenge_rooms")
}

model RoomOffer {
  id                String          @id @default(cuid())
  roomId            String          @map("room_id")
  room              ChallengeRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposerId        String          @map("proposer_id")
  proposer          User            @relation(fields: [proposerId], references: [id])
  proposerRole      RoomRole        @map("proposer_role")
  version           Int             @default(1)
  actionText        String          @map("action_text") @db.Text
  taskType          TaskType        @map("task_type")
  targetUrl         String          @map("target_url")
  deadline          DateTime
  requiresProof     Boolean         @default(true) @map("requires_proof")
  proofInstructions String?         @map("proof_instructions") @db.Text
  status            RoomOfferStatus @default(PROPOSED)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  submissions RoomSubmission[]

  @@unique([roomId, proposerRole])
  @@index([roomId, status])
  @@map("room_offers")
}

model RoomSubmission {
  id            String               @id @default(cuid())
  roomId        String               @map("room_id")
  room          ChallengeRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  offerId       String               @map("offer_id")
  offer         RoomOffer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  submittedById String               @map("submitted_by_id")
  submittedBy   User                 @relation(fields: [submittedById], references: [id])
  proofUrl      String?              @map("proof_url")
  proofHash     String?              @map("proof_hash")
  note          String?              @db.Text
  status        RoomSubmissionStatus @default(SUBMITTED)
  reviewedById  String?              @map("reviewed_by_id")
  reviewedAt    DateTime?            @map("reviewed_at")
  reviewNote    String?              @map("review_note") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([roomId, status])
  @@index([offerId, status])
  @@map("room_submissions")
}

// Active-room slot — one non-terminal room per user across both roles.
// Partial unique index (user_id WHERE released_at IS NULL) is created by
// the migration SQL; Prisma cannot express partial indexes in schema.
model RoomParticipation {
  id         String        @id @default(cuid())
  roomId     String        @map("room_id")
  room       ChallengeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RoomRole
  joinedAt   DateTime      @default(now()) @map("joined_at")
  releasedAt DateTime?     @map("released_at")

  @@index([userId, releasedAt])
  @@index([roomId])
  @@map("room_participations")
}

model RoomNudge {
  id        String        @id @default(cuid())
  roomId    String        @map("room_id")
  room      ChallengeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String        @map("sender_id")
  sender    User          @relation("NudgeSender", fields: [senderId], references: [id], onDelete: Cascade)
  pingId    String        @map("ping_id")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([roomId, pingId])
  @@index([roomId, createdAt])
  @@map("room_nudges")
}

model RoomRating {
  id         String        @id @default(cuid())
  roomId     String        @map("room_id")
  room       ChallengeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  raterId    String        @map("rater_id")
  rater      User          @relation("RatingGiver", fields: [raterId], references: [id], onDelete: Cascade)
  rateeId    String        @map("ratee_id")
  ratee      User          @relation("RatingReceiver", fields: [rateeId], references: [id], onDelete: Cascade)
  score      Int
  review     String?       @db.Text
  hiddenAt   DateTime?     @map("hidden_at")
  hiddenById String?       @map("hidden_by_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([roomId, raterId])
  @@index([rateeId, hiddenAt])
  @@map("room_ratings")
}

model RoomDispute {
  id           String        @id @default(cuid())
  roomId       String        @map("room_id")
  room         ChallengeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  openedById   String        @map("opened_by_id")
  openedBy     User          @relation("DisputeOpener", fields: [openedById], references: [id])
  reason       String        @db.Text
  evidence     Json?
  status       ReportStatus  @default(OPEN)
  resolution   String?       @db.Text
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([roomId])
  @@map("room_disputes")
}

model P2pPointEvent {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId         String        @map("room_id")
  room           ChallengeRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  role           RoomRole
  points         Int           @default(1)
  reversedAt     DateTime?     @map("reversed_at")
  reversalReason String?       @map("reversal_reason")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([userId, roomId])
  @@index([userId, reversedAt])
  @@map("p2p_point_events")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @map("addressee_id")
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}
