# ─── API Configuration ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Internal cache revalidation (server-side only, never NEXT_PUBLIC) ──
# Shared secret the API sends to /api/internal/revalidate after blog
# mutations. Must match INTERNAL_REVALIDATE_SECRET on the API.
INTERNAL_REVALIDATE_SECRET=

# ─── reCAPTCHA v3 (for bot protection) ───────────────────────
# Get site key from: https://www.google.com/recaptcha/admin
# Note: This is the SITE KEY (public), not the SECRET KEY (server-side)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
