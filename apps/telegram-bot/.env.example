# ───────── REQUIRED ─────────
# Token of the bot that will run this code (create a NEW bot with @BotFather -> /newbot).
# NOTE: you cannot reuse the token of a bot that is already running somewhere else.
BOT_TOKEN=

# Your Telegram numeric user id(s) – full access to the developer panel (/panel). Comma separated.
# Get yours from @userinfobot
OWNER_IDS=

# ───────── OPTIONAL ─────────
BOT_NAME=Engganyo
# Group/channel id where /support tickets and /intervention requests are also sent (bot must be a member)
SUPPORT_CHAT_ID=0
DB_PATH=data/guardbot.db
DEFAULT_LANG=en
DEFAULT_TZ=UTC
LOG_LEVEL=INFO
# Anti-NSFW: true uses NudeNet if installed (pip install nudenet) else a light skin-tone heuristic
NSFW_ENABLED=true
# Webhook mode (leave empty to use long polling – the easiest)
WEBHOOK_URL=
WEBHOOK_PORT=8443

# Support button: where people reach the Engganyo team
SUPPORT_URL=https://engganyo.com
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=Engganyo

# ───────── ENGGANYO PLATFORM LINK (Phase 1, optional) ─────────
# All three must be set or the platform channel stays disabled. The service
# key is a scoped bot-to-platform credential minted by the platform - never
# a user token, never logged. ENGGANYO_BOT_USERNAME is checked via getMe at
# startup and the bot refuses the platform channel on a mismatch.
ENGGANYO_API_BASE=
ENGGANYO_BOT_SERVICE_KEY=
ENGGANYO_BOT_USERNAME=EngganyoBot
